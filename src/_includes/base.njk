<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
{% set pageDesc = description or site.tagline %}
{% set fullTitle = title + ' · ' + site.name if title else site.name %}
{% set canonical = site.url + page.url %}
{% set ogImage = site.url + '/og.png' %}
<title>{{ fullTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ canonical }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ fullTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ ogImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site.name }}">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ fullTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ ogImage }}">
<link rel="icon" href="/favicon.svg"><link rel="stylesheet" href="/css/style.css">
{% if page.url == '/' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ site.name | jsonld | safe }},
  "url": {{ (site.url + '/') | jsonld | safe }},
  "description": {{ site.tagline | jsonld | safe }}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ (title or site.name) | jsonld | safe }},
  "itemListElement": [
    {%- for item in db.connectors %}
    {"@type":"ListItem","position":{{ loop.index }},"name":{{ item.name | jsonld | safe }},"url":{{ (site.url + '/c/' + item.id + '/') | jsonld | safe }}}{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
{% elif c and c.id %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": {{ c.name | jsonld | safe }},
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any",
  "description": {{ (c.capabilities or pageDesc) | jsonld | safe }},
  "url": {{ canonical | jsonld | safe }},
  "offers": {"@type":"Offer","description":{{ c.price | jsonld | safe }}},
  "sameAs": {{ c.docs_url | jsonld | safe }}
}
</script>
{% elif category and category.connectors %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ category.title | jsonld | safe }},
  "itemListElement": [
    {%- for item in category.connectors %}
    {"@type":"ListItem","position":{{ loop.index }},"name":{{ item.name | jsonld | safe }},"url":{{ (site.url + '/c/' + item.id + '/') | jsonld | safe }}}{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
{% elif guide %}
{% set guideRows = db.connectors | where('brand_group', guide.brandGroup) %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ guide.title | jsonld | safe }},
  "itemListElement": [
    {%- for item in guideRows %}
    {"@type":"ListItem","position":{{ loop.index }},"name":{{ item.name | jsonld | safe }},"url":{{ (site.url + '/c/' + item.id + '/') | jsonld | safe }}}{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
{% endif %}
</head>
<body>
<header class="top"><div class="wrap nav">
  <a class="logo" href="/"><img src="/favicon.svg" alt="" width="28" height="28"> Wire<b>My</b>Life</a>
  <nav><a href="/pick/tesla/">Tesla</a><a href="/pick/home-assistant/">Home Assistant</a><a href="/my-stack/">My stack</a><a href="/how-we-check/">How we check</a><a href="/advertise/">Advertise</a><a class="btn sm" href="/newsletter/">Newsletter</a></nav>
</div></header>
<main class="wrap">{{ content | safe }}</main>
<footer class="foot"><div class="wrap">
  <p><b>WireMyLife</b> · {{ db.total }} connectors · statuses last checked {{ db.last_run | date }}</p>
  <p><a href="/car/">Car</a> · <a href="/home/">Home</a> · <a href="/best/tesla-mcp-servers/">Best Tesla connectors</a> · <a href="/best/home-assistant-ai-connectors/">Best Home Assistant connectors</a></p>
  <p><a href="/submit/">Submit a connector</a> · <a href="/advertise/">Get featured</a> · <a href="/how-we-check/">How we check</a> · <a href="/newsletter/">Newsletter</a> · <a href="/disclosure/">Disclosure</a></p>
  <p class="muted">Independent. Not affiliated with Tesla, Home Assistant, or any vendor listed. Featured listings and sponsors are always labelled. Affiliate links are marked. Never give an AI connector more access than you'd give a stranger with your keys.</p>
</div></footer>
</body></html>
