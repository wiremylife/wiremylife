<div class="table-wrap"><table class="compare">
<thead><tr>{% if ranked %}<th>#</th>{% endif %}<th>Connector</th><th>Status</th><th>Type</th><th>Works with</th><th>Access</th><th>Setup</th><th>Price</th></tr></thead>
<tbody>{% for c in rows %}<tr>
{% if ranked %}<td class="rank">{{ loop.index }}</td>{% endif %}
<td><a href="/c/{{ c.id }}/">{{ c.name }}</a>{% if c.isFeatured %} <span class="featured-flag">Featured</span>{% endif %}</td><td><span class="badge {{ c.badge.cls }}">{{ c.badge.label }}</span></td>
<td>{{ 'Hosted' if c.type == 'hosted' else ('Built-in' if c.type == 'built-in' else 'Self-hosted') }}</td>
<td class="small">{{ c.assistants | join(', ') }}</td><td>{{ c.access }}</td><td>{{ c.setup_difficulty }}/5</td><td class="small">{{ c.price }}</td>
</tr>{% endfor %}</tbody></table></div>
